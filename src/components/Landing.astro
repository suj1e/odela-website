---
import '../styles/landing.css';
import ThemeHead from './ThemeHead.astro';
import ThemeSelect from './ThemeSelect.astro';
interface Props {
  lang: 'zh' | 'en';
}
const { lang } = Astro.props;
const zh = lang === 'zh';
const text = zh
  ? {
      tag: '多 agent 的本地工作台',
      title: '多个 agents，\n一个工作台。',
      lead: '每个 agent 有自己的 space、session 和 pane；原生桌面，CLI 可控，session 在 core 里继续跑。',
      download: '下载 0.1.0',
      docs: '文档',
      features: [
        ['多个 agents', 'OMP、Pi，之后还会更多；各自有 space 和 session。'],
        ['Spaces', '按项目组织 agents 和 sessions，不混上下文。'],
        ['Panes', 'chat、browser、files、terminal 组合，不抢同一个窗口。'],
        ['CLI 可控', 'agent 用 odela --skills 发现能力，直接控制 pane。'],
      ],
      note: '0.1.0 为未签名开发版；截图与下载在发布前补齐。',
    }
  : {
      tag: 'A local-first multi-agent workspace',
      title: 'Multiple agents.\nOne workspace.',
      lead: 'Each agent gets its own space, session and panes. Native desktop, CLI control, sessions that keep running in core.',
      download: 'Download 0.1.0',
      docs: 'Docs',
      features: [
        ['Multiple agents', 'OMP and Pi first; more through adapters later.'],
        ['Spaces', 'Organize agents and sessions by project without mixing context.'],
        ['Panes', 'Chat, browser, files and terminal side by side.'],
        ['CLI control', 'Agents discover odela --skills and control panes directly.'],
      ],
      note: '0.1.0 is an unsigned developer build; screenshots and downloads land before release.',
    };
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>odela</title>
    <meta name="description" content={text.lead} />
    <link rel="icon" href="/icon.png" />
    <ThemeHead />
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href={zh ? '/' : '/en/'}>
        <img src="/icon.png" alt="" width="28" height="28" />
        <span>odela</span>
      </a>
      <nav>
        <a href={zh ? '/docs' : '/en/docs'}>{text.docs}</a>
        <a class="nav-download" href={zh ? '/download' : '/en/download'}>{text.download}</a>
        <ThemeSelect lang={lang} />
        <a href={zh ? '/en/' : '/'}>{zh ? 'EN' : '中文'}</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="tag">{text.tag}</p>
          <h1>{text.title}</h1>
          <p class="lead">{text.lead}</p>
          <div class="actions">
            <a class="button primary" href={zh ? '/download' : '/en/download'}>{text.download}</a>
            <a class="button" href={zh ? '/docs' : '/en/docs'}>{text.docs}</a>
          </div>
        </div>
        <div class="mark" aria-hidden="true">
          <img src="/icon.png" alt="" />
        </div>
      </section>

      <section class="features">
        {text.features.map(([title, body]) => (
          <article>
            <h2>{title}</h2>
            <p>{body}</p>
          </article>
        ))}
      </section>

      <p class="note">{text.note}</p>
    </main>

    <footer>
      <span>odela</span>
      <a href="https://github.com/suj1e/odela-releases">GitHub Releases</a>
    </footer>
  </body>
</html>
